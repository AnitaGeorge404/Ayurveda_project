# Copy this file to .env and fill in your own values. Never commit .env.

NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=neo4j

# Optional. Similarity floor for the semantic-retrieval fallback (0-1).
# Not a scientifically validated cutoff -- tune it against your own test
# questions (see tests/run_eval.py).
EVIDENCE_THRESHOLD=0.80

# Optional. Set to enable LLM-based answer phrasing (still fully evidence-
# gated and grounding-checked). Leave blank to use the deterministic
# template answer generator instead.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional. Set to "false" to disable the TF-IDF semantic-retrieval fallback
# and rely on structured Cypher retrieval only.
USE_SEMANTIC_RETRIEVAL=true
